{
  "name": "frost-and-fin",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:web && npm run build:download",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/game/model.test.ts",
    "test:browser": "playwright test",
    "build:web": "tsc -b && vite build",
    "build:download": "vite build --mode standalone && node scripts/package-game.mjs",
    "test:launch": "npm run build && playwright test --config playwright.launch.config.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.1",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
